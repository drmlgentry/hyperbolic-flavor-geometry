# Normalize line endings: store as LF, checkout as CRLF on Windows
* text=auto

# Force LF for specific types (never auto-convert these)
*.tex text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.bib text eol=lf
*.sh  text eol=lf
*.ps1 text eol=crlf

# Binary files — never touch
*.pdf binary
*.png binary
*.jpg binary
*.jfif binary
*.zip binary
*.exe binary

# Atlas outputs whose SHA-256 hashes are recorded in reproduce/m003_atlas_manifest.json
# were written with CRLF line endings; store the exact bytes so the manifest verifies.
reproduce/m003_filling_summary.csv -text
reproduce/m003_pair_atlas.csv -text
reproduce/m003_word_atlas.csv -text
