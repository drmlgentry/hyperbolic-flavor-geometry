    ['ABBab', 'ABabb']  ->  (-t**8 + 3*t**6 - t**4 - 2*t**2 + 1)/t**2
    ['AAAABB', 'AABAAb']  ->  -t**6 + 3*t**4 - 2*t**2 + 1
    ['AAABAb', 'AAAbAB']  ->  (-t**8 + 4*t**6 - 4*t**4 - t**2 + 1)/t**2
    ['AABAbb', 'AAbbAB']  ->  (t**8 - 4*t**6 + 3*t**4 + 2*t**2 - 2)/t
    ['AABBaB', 'AABaBB']  ->  (t**8 - 3*t**6 + 4*t**2 - 1)/t
    ['AABabb', 'AAbbaB']  ->  (-t**8 + 3*t**6 - t**4 - 2*t**2 + 2)/t
    ['AAbAbb', 'AAbbAb']  ->  (-t**10 + 4*t**8 - 3*t**6 - 3*t**4 + 2*t**2 + 1)/t
    ['ABABab', 'ABAbaB', 'ABaBaB']  ->  (-t**6 + 2*t**4 + t**2 - 1)/t**3
    ['ABBBab', 'ABabbb']  ->  t**8 - 4*t**6 + 3*t**4 + 3*t**2 - 3
    ['ABaBab', 'ABabAb']  ->  (-t**10 + 3*t**8 - 4*t**4 + 1)/t**3

